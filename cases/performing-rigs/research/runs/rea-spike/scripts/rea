#!/bin/bash
# Isolated REA (morluto/rea main @ ddcdb3c37837fb8eda0fdee92853774453f1b4ef) on Node 24.21.0,
# using the existing Homebrew Ghidra 12.1.3 + JDK 21 read-only. Nothing is installed globally.
: "${REA_SPIKE_ROOT:?set REA_SPIKE_ROOT to the spike work directory}"
export PATH="$REA_SPIKE_ROOT/node/bin:/opt/homebrew/opt/openjdk@21/bin:/usr/bin:/bin"
export JAVA_HOME=/opt/homebrew/opt/openjdk@21
export GHIDRA_INSTALL_DIR=/opt/homebrew/Cellar/ghidra/12.1.3/libexec
export HOME="$REA_SPIKE_ROOT/rea-home"
exec "$REA_SPIKE_ROOT/node/bin/node" "$REA_SPIKE_ROOT/rea-src/rea/scripts/rea.mjs" "$@"
