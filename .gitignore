/Autopilot_firm/*.bin
/Autopilot_firm/bossac.exe
/Autopilot_firm/desktop.ini
/PerformingRigs_UserManual_AutoPilot.pdf
/research/firmware/originals/*.bin
/research/firmware/extracted/*

