# Upstream Galois clone (macaw + crucible/what4/semmc/dismantle/asl-translator
# submodules) -- ~2.7GB, its own git history. Not vendored; see README.md for
# the exact clone/build steps to recreate it.
/external/

# cabal build artifacts (built under external/macaw when following the README)
dist-newstyle/
*.hi
*.o

# Proprietary firmware and vendor tooling -- do not redistribute.
# Hashes are tracked (SHA256SUMS.txt); the binaries/manual/flasher are not.
/Autopilot_firm/*.bin
/Autopilot_firm/bossac.exe
/Autopilot_firm/desktop.ini
/PerformingRigs_UserManual_AutoPilot.pdf
/research/firmware/originals/*.bin
/research/firmware/extracted/*

# Reproducible Python venv for tools/unicorn/run_concrete.py -- rebuild via
# tools/doctor.sh or docs/tooling/tool-selection.md; pinned in requirements.txt.
/tools/unicorn/.venv/

.DS_Store

# Persistent Ghidra project cache (tools/ghidra/aptrace_ghidra.py) -- fully
# regenerable via `aptrace_ghidra.py build <firmware-key>`; not distributed.
/research/runs/ghidra_cache/

# aptrace census database + dynamic-coverage capture files
# (tools/census/) -- fully regenerable via
# `aptrace_census.py build <firmware-key>` + dynamic_export.py; not
# distributed. See docs/tooling/census.md.
/research/runs/census/
